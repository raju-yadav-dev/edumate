{
  "name": "edumate-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/startup.js",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "ingest": "node server/scripts/runChunkingWorker.js",
    "sync-storage": "node server/scripts/syncStorage.js",
    "reindex": "node scripts/migrateToJina.js",
    "doctor": "node scripts/doctor.js",
    "qa": "node tests/runner.js",
    "clean": "node scripts/clean.js",
    "setup": "node scripts/setup.js",
    "format": "node scripts/format.js",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "backup": "node scripts/backupRestoreCenter.js --backup",
    "restore": "node scripts/backupRestoreCenter.js --restore"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "puppeteer-core": "^25.12.0"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "dotenv": "^17.4.2"
  }
}
