# ======================================================
# APPLICATION
# ======================================================

NODE_ENV=development
PORT=5000


# ======================================================
# DATABASE
# ======================================================

MONGODB_URI=


# ======================================================
# JWT
# ======================================================

JWT_SECRET=


# ======================================================
# SUPABASE
# ======================================================

# ------------------------------------------------------
# File Database
# ------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_QUOTA_MB=1024
SUPABASE_SIGNED_URL_TTL_SECONDS=3600


# ------------------------------------------------------
# Crawler
# ------------------------------------------------------

CRAWLER_SUPABASE_URL=
CRAWLER_SUPABASE_SERVICE_ROLE_KEY=
CRAWLER_SUPABASE_STORAGE_BUCKET=edumate-crawler
CRAWLER_SUPABASE_STORAGE_QUOTA_MB=1024
CRAWLER_SUPABASE_SIGNED_URL_TTL_SECONDS=3600


# ======================================================
# VECTOR DATABASE - QDRANT
# ======================================================

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=edumate


# ======================================================
# AI / LLM PROVIDER
# ======================================================

# Supported:
# gemini | ollama | openAI | groq

LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=


# ======================================================
# GEMINI
# ======================================================

# Kept only if other existing functionality still uses Gemini.

GEMINI_API_KEY=
GEMINI_COMPLETION_MODEL=


# ======================================================
# OLLAMA
# ======================================================

# Optional local development provider.

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=


# ======================================================
# EMBEDDINGS - JINA AI
# ======================================================

EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3

JINA_API_KEY=

# Jina v3 is configured to produce 768-dimensional vectors.
EMBEDDING_DIMENSION=768


# ======================================================
# JINA RATE LIMITING
# ======================================================

# Keep below Jina's 100,000 tokens/minute limit
# to provide a safety margin.

JINA_MAX_TOKENS_PER_MINUTE=80000

# Prevent multiple workers from hitting Jina simultaneously.
JINA_MAX_CONCURRENT_REQUESTS=1

# Retry configuration for HTTP 429/rate-limit responses.
JINA_MAX_RETRIES=5

# Initial retry delay in milliseconds.
JINA_RETRY_DELAY_MS=2000

# Maximum retry delay in milliseconds.
JINA_MAX_RETRY_DELAY_MS=30000


# ======================================================
# FILE UPLOAD
# ======================================================

MAX_FILE_SIZE=10485760