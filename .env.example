PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_RATE_LIMIT_MAX=300

MONGODB_URI=your_mongodb_connection_string
MONGODB_STORAGE_LIMIT_MB=512
ADMIN_STORAGE_LIMIT_MB=512

JWT_SECRET=your_jwt_secret
JWT_ACCESS_TOKEN_EXPIRES_IN=7d

SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=your_supabase_storage_bucket
SUPABASE_STORAGE_QUOTA_MB=1024
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

GEMINI_API_KEY=your_gemini_api_key

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=edumate
