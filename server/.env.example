# ======================================================
# APPLICATION
# ======================================================
NODE_ENV=development
PORT=5000

# ======================================================
# DATABASE
# ======================================================
MONGODB_URI=

# ======================================================
# JWT
# ======================================================
JWT_SECRET=


# ======================================================
# SUPABASE
# ======================================================
#File Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_QUOTA_MB=
SUPABASE_SIGNED_URL_TTL_SECONDS=

#Crawler
CRAWLER_SUPABASE_URL=
CRAWLER_SUPABASE_SERVICE_ROLE_KEY=
CRAWLER_SUPABASE_STORAGE_BUCKET=
CRAWLER_SUPABASE_STORAGE_QUOTA_MB=
CRAWLER_SUPABASE_SIGNED_URL_TTL_SECONDS=

# ======================================================
# VECTOR DATABASE (Qdrant)
# ======================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# ======================================================
# AI PROVIDER
# gemini | ollama | openAI | groq
# ======================================================
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=

# ======================================================
# GEMINI (Fallback)
# ======================================================
GEMINI_API_KEY=
GEMINI_COMPLETION_MODEL=

# ======================================================
# OLLAMA (Local Development)
# ======================================================
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ======================================================
# EMBEDDINGS
# ======================================================
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
JINA_API_KEY=your_jina_api_key

# ======================================================
# FILE UPLOAD
# ======================================================
MAX_FILE_SIZE=10485760

# ======================================================
# ROUTING & SAFETY
# ======================================================
OPENROUTE_SERVICE_API_KEY=
OPENROUTE_SERVICE_URL=https://api.openrouteservice.org

OVERPASS_URL=https://overpass-api.de/api/interpreter

ROUTE_SAFETY_RADIUS_METERS=60
ROUTE_SAFETY_CACHE_TTL_SECONDS=300

CRIME_DATA_ENABLED=true
CRIME_DATA_URL=
CRIME_DATA_API_KEY=
CRIME_DATA_FORMAT=geojson

CRIME_DATA_RADIUS_METERS=150
CRIME_DATA_LOOKBACK_DAYS=90
CRIME_DATA_CACHE_TTL_SECONDS=600

CRIME_HARD_EXCLUSION_SCORE=75
CRIME_HOTSPOT_EXCLUSION_SCORE=85

CRIME_SCORE_MULTIPLIER=5

PHYSICAL_RISK_WEIGHT=0.45
CRIME_RISK_WEIGHT=0.55

REQUIRE_CRIME_DATA_FOR_SAFE_ROUTE=false