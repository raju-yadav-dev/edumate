# ======================================================
# APPLICATION
# ======================================================
NODE_ENV=development
PORT=5000

# ======================================================
# DATABASE
# ======================================================
MONGODB_URI=

# ======================================================
# JWT
# ======================================================
JWT_SECRET=


# ======================================================
# SUPABASE
# ======================================================
#File Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_QUOTA_MB=
SUPABASE_SIGNED_URL_TTL_SECONDS=

#Crawler
CRAWLER_SUPABASE_URL=
CRAWLER_SUPABASE_SERVICE_ROLE_KEY=
CRAWLER_SUPABASE_STORAGE_BUCKET=
CRAWLER_SUPABASE_STORAGE_QUOTA_MB=
CRAWLER_SUPABASE_SIGNED_URL_TTL_SECONDS=

# ======================================================
# VECTOR DATABASE (Qdrant)
# ======================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# ======================================================
# AI / LLM PROVIDER
# ======================================================
LLM_PROVIDER=llama.cpp
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=Qwen3-1.7B-Instruct-Q4_K_M.gguf

LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512
LLM_CONTEXT_SIZE=4096
LLM_STREAM=true
LLM_TIMEOUT=30000

# Legacy cloud keys (optional / disabled)
GROQ_API_KEY=
GROQ_MODEL=

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=

AI_PROVIDER_KEY_COOLDOWN_MS=60000

# ======================================================
# GEMINI (Fallback)
# ======================================================
GEMINI_API_KEY=
GEMINI_COMPLETION_MODEL=

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# ======================================================
# OLLAMA (Local Development)
# ======================================================
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ======================================================
# EMBEDDINGS
# ======================================================
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
JINA_API_KEY=your_jina_api_key

# ======================================================
# AI PERFORMANCE / RAG TOKEN BUDGET
# ======================================================
LLM_MAX_OUTPUT_TOKENS=500
LLM_TIMEOUT_MS=20000
RAG_MAX_CHUNKS=4
RAG_MAX_CHUNKS_PER_INTENT=3
RAG_MAX_CHUNK_CHARS=4500
RAG_HISTORY_MAX_TOKENS=500
RAG_MAX_HISTORY_CHARS=2000
RAG_EXPAND_ADJACENT=false
RAG_CANDIDATES_TO_VALIDATE=6
ENABLE_LLM_QUERY_ANALYSIS=false

# ======================================================
# FILE UPLOAD
# ======================================================
MAX_FILE_SIZE=10485760

# ======================================================
# ROUTING & SAFETY
# ======================================================
OPENROUTE_SERVICE_API_KEY=
OPENROUTE_SERVICE_URL=https://api.openrouteservice.org

OVERPASS_URL=https://overpass-api.de/api/interpreter

ROUTE_SAFETY_RADIUS_METERS=60
ROUTE_SAFETY_CACHE_TTL_SECONDS=300

CRIME_DATA_ENABLED=true
CRIME_DATA_URL=
CRIME_DATA_API_KEY=
CRIME_DATA_FORMAT=geojson

CRIME_DATA_RADIUS_METERS=150
CRIME_DATA_LOOKBACK_DAYS=90
CRIME_DATA_CACHE_TTL_SECONDS=600

CRIME_HARD_EXCLUSION_SCORE=75
CRIME_HOTSPOT_EXCLUSION_SCORE=85

CRIME_SCORE_MULTIPLIER=5

PHYSICAL_RISK_WEIGHT=0.45
CRIME_RISK_WEIGHT=0.55

REQUIRE_CRIME_DATA_FOR_SAFE_ROUTE=false